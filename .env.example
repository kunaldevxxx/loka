# ==============================================================================
# LOKA CAFE PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT (Cloudflare Pages)
# ------------------------------------------------------------------------------
# Set this in Cloudflare Pages Dashboard -> Settings -> Environment Variables
# For local dev, you can leave it empty to use relative /api proxy.
# For production split deployment, set it to your Render backend URL:
VITE_API_BASE_URL=https://loka-cafe-backend.onrender.com

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT (Render Web Service)
# ------------------------------------------------------------------------------
# Production environment indicator
NODE_ENV=production

# Render automatically sets PORT to 10000; defaults to 3001 locally
PORT=10000

# Secret key used for signing and verifying JWT tokens for Manager, Chef, and Support
JWT_SECRET=change_to_a_secure_random_jwt_secret_32_chars_or_more

# Allowed CORS Origins:
# Set to '*' for all origins or specify your Cloudflare Pages domain:
# e.g., https://loka-cafe.pages.dev or https://loka-cafe-platform.pages.dev
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 3. AI VOICE & SPEECH INTEGRATION (Optional)
# ------------------------------------------------------------------------------
# Sarvam AI API Key for Indic Voice Ordering (Bulbul TTS & Saaras STT across 11 Indian languages)
# Free tier key available at: https://www.sarvam.ai
SARVAM_API_KEY=

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Optional)
# ------------------------------------------------------------------------------
# Live Razorpay credentials (if left blank, simulated instant UPI payments are used)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
